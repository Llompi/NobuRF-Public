{
  "name": "noburf",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Browser-based 3D WebGPU FDTD antenna solver with a local tool bridge for an OpenClaw + Kimi K3.1 Pro tuning agent.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,bridge -c cyan,magenta \"vite\" \"tsx watch server/bridge.ts\"",
    "dev:web": "vite",
    "dev:bridge": "tsx watch server/bridge.ts",
    "build": "tsc --noEmit && vite build",
    "build:site": "bash scripts/build_site.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "tsx scripts/gpu_selftest.ts",
    "test:gpu:node": "node --import tsx --import ./src/node/register_raw_imports.mjs bench/webgpu_node/selftest_node.ts",
    "bench:wgsl": "node --import tsx --import ./src/node/register_raw_imports.mjs bench/webgpu_node/bench_wgsl.ts",
    "roundtrip": "tsx scripts/bridge_roundtrip.ts",
    "cerebras:ping": "tsx scripts/cerebras_ping.ts",
    "validate:analytic": "tsx scripts/validate/analytic.ts",
    "validate:patch": "tsx scripts/validate/patch.ts",
    "validate:benchmarks": "tsx scripts/validate/benchmarks.ts",
    "validate:lumped": "tsx scripts/validate/lumped_components.ts",
    "validate:plots": "python docs/validation/plot.py",
    "validate:deembed": "node --import tsx --import ./src/node/register_raw_imports.mjs scripts/validate/deembed.ts",
    "selfverify": "tsx scripts/selfverify/run.ts",
    "noburf": "node --import tsx --import ./src/node/register_raw_imports.mjs scripts/noburf.ts",
    "design": "node --import tsx --import ./src/node/register_raw_imports.mjs scripts/design.ts"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@webgpu/types": "^0.1.74",
    "concurrently": "^10.0.7",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "webgpu": "^0.6.2"
  }
}
